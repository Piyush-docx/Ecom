# macOS
.DS_Store

# Generated knowledge-graph output. Regenerable from source, and its manifest
# records absolute paths and local mtimes that are meaningless on any other
# machine.
graphify-out/

# Go build and test artifacts
*.exe
*.test
*.out
coverage.html

# Compiled service and gateway binaries. `go build` inside a module directory
# drops one named after the module, which is build output, not source.
/gateway/gateway
/services/auth/auth
/services/catalog/catalog
/services/orders/orders
/services/payment/payment

# go.work.sum is machine-local; go.work itself is committed so a clone gets the
# multi-module layout for free.
go.work.sum

# Planning and agent-workflow documents. Deliberately kept out of the
# repository, but retained locally as the working source of truth for the
# remaining phases. Listed here so a `git add -A` cannot silently re-add them.
AGENTS.md
IMPLEMENTATION_PLAN.md

# Secrets — .env.example is committed instead (see the local plan, Phase 9).
.env
.env.local
*.pem
*.key
