# Copy to .env and adjust. .env is gitignored; this file is committed.
#
#   cp .env.example .env
#
# Every value below is a development default. The only variable with no safe
# default is JWT_SECRET, which both the gateway and auth refuse to start
# without -- deliberately, so a development fallback can never reach production
# as the real signing key.


# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs and verifies JWTs. Must be identical across auth and every gateway
# instance, or tokens issued by auth will not validate at the gateway.
#
# auth enforces a 32-byte minimum. Generate one with:
#   openssl rand -hex 32
#
# The value below is a placeholder for local development. Do not use it
# anywhere that matters.
JWT_SECRET=replace-me-with-openssl-rand-hex-32-output-at-least-32-bytes


# ---------------------------------------------------------------------------
# Rate limiting (gateway)
# ---------------------------------------------------------------------------

# Requests permitted per window, per caller. Enforced across ALL gateway
# instances combined via Redis, not per instance -- see docs/adr/0001.
RATE_LIMIT=100
RATE_LIMIT_WINDOW=1m

# The Phase 7 load test raises RATE_LIMIT to a large value so the limiter does
# not become the bottleneck while measuring checkout throughput. See
# deploy/testdata/phase7-acceptance.txt.


# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------

REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092

# Comma-separated for a multi-broker cluster:
#   KAFKA_BROKERS=broker-1:9092,broker-2:9092,broker-3:9092


# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
#
# One logical database per service: no service reads another's tables, and
# migrations are owned by the service that runs them.
#
# ecom:ecom is the local docker-compose credential. Postgres publishes no port
# in deploy/docker-compose.full.yml -- it is reachable only inside the Docker
# network -- so this is a development convenience, not a deployed secret.

AUTH_DATABASE_URL=postgres://ecom:ecom@localhost:5432/ecom_auth?sslmode=disable
CATALOG_DATABASE_URL=postgres://ecom:ecom@localhost:5432/ecom_catalog?sslmode=disable
ORDERS_DATABASE_URL=postgres://ecom:ecom@localhost:5432/ecom_orders?sslmode=disable
PAYMENT_DATABASE_URL=postgres://ecom:ecom@localhost:5432/ecom_payment?sslmode=disable


# ---------------------------------------------------------------------------
# Listen addresses
# ---------------------------------------------------------------------------

GATEWAY_ADDR=:8080
AUTH_ADDR=:8081
CATALOG_ADDR=:8082
ORDERS_ADDR=:8083
PAYMENT_ADDR=:8084


# ---------------------------------------------------------------------------
# Service discovery (gateway -> services)
# ---------------------------------------------------------------------------
#
# In docker-compose these are container names (http://auth:8081). Running the
# binaries directly on the host, they are localhost.

AUTH_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
ORDERS_SERVICE_URL=http://localhost:8083
PAYMENT_SERVICE_URL=http://localhost:8084


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# debug | info | warn | error. Anything unrecognised falls back to info rather
# than silencing the service, so a typo cannot hide an outage.
LOG_LEVEL=info

# JWT claims. Issuer defaults to ecom-auth; audience is unset by default, and
# when set the gateway requires tokens to carry it.
JWT_ISSUER=ecom-auth
# JWT_AUDIENCE=

# Access-token lifetime. Default 1h.
JWT_TTL=1h

# The payment processor is a stub standing in for Stripe. Any charge for
# exactly this amount fails, which makes the saga's compensating path
# reproducible on demand instead of random. Unset means no charge ever fails.
# PAYMENT_FAIL_AMOUNT_CENTS=666


# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------
#
# The integration suites skip when these are unset or unreachable, so
# `go test ./...` stays honest on a machine with no backends. CI sets them and
# then fails the build if any test skipped -- a skipped test would otherwise
# look identical to a passing one.

# Requests driven into one key by the ADR 0001 memory-footprint test. Raising
# it is what shows the sliding window log's O(n) growth against the other two
# staying flat. Default 5000.
# MEMTEST_REQUESTS=5000

# RATELIMITER_TEST_REDIS_ADDR=127.0.0.1:6379
# KAFKA_TEST_BROKERS=127.0.0.1:9092
# AUTH_TEST_DATABASE_URL=postgres://ecom:ecom@127.0.0.1:5432/ecom_auth?sslmode=disable
# CATALOG_TEST_DATABASE_URL=postgres://ecom:ecom@127.0.0.1:5432/ecom_catalog?sslmode=disable
# ORDERS_TEST_DATABASE_URL=postgres://ecom:ecom@127.0.0.1:5432/ecom_orders?sslmode=disable
# PAYMENT_TEST_DATABASE_URL=postgres://ecom:ecom@127.0.0.1:5432/ecom_payment?sslmode=disable
